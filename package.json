{
  "name": "ci-cd-minimaliste",
  "version": "1.0.0",
  "description": "Petite API text-utils (Node + TypeScript + Express) servant de support à un pipeline CI/CD GitHub Actions minimaliste.",
  "license": "MIT",
  "author": "Noumabeu Moutacdie Jordan",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
